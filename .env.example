# 複製成 .env（已 gitignore）。Agent SDK 底層 Claude Code engine 會從環境變數讀取認證。

# ── Claude 認證（擇一）──
# (A) 走 gateway/proxy：Bearer token + 自訂端點
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# (B) 或標準 API key（與 A 擇一，勿同時設）
# ANTHROPIC_API_KEY=

# ── 其他服務 ──
# GITHUB_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
